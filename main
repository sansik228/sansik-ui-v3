-- ==========================================
-- SANSİK UI LIBRARY (v1.1 - Fixed)
-- Создано для Real Executor. Заливай на GitHub и юзай через loadstring.
-- ==========================================

local SansikUI = {}
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local GuiParent = pcall(function() return CoreGui end) and CoreGui or Players.LocalPlayer:WaitForChild("PlayerGui")

-- Конфиг темы
local Theme = {
    Background = Color3.fromRGB(15, 15, 20),
    Secondary = Color3.fromRGB(25, 25, 30),
    Accent = Color3.fromRGB(0, 255, 140),
    Text = Color3.fromRGB(240, 240, 240),
    TextDark = Color3.fromRGB(150, 150, 150),
    Red = Color3.fromRGB(255, 60, 60)
}

-- Удаляем старую версию
if GuiParent:FindFirstChild("SansikUI") then
    GuiParent.SansikUI:Destroy()
end

-- Основной ScreenGui
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "SansikUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.Parent = GuiParent

-- Блюр
local Blur = Instance.new("BlurEffect")
Blur.Size = 0
Blur.Parent = Lighting

-- Хелпер для создания элементов
local function create(className, props, parent)
    local inst = Instance.new(className)
    for k, v in pairs(props) do
        inst[k] = v
    end
    inst.Parent = parent
    return inst
end

-- Хелпер для скругления
local function corner(parent, radius)
    return create("UICorner", {CornerRadius = UDim.new(0, radius)}, parent)
end

-- Хелпер для обводки
local function stroke(parent, color, thickness)
    return create("UIStroke", {Color = color, Thickness = thickness, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, parent)
end

-- ==========================================
-- СИСТЕМА ОКНА
-- ==========================================
function SansikUI:CreateWindow(config)
    local Window = {}

    -- Плашка (Свернутое состояние)
    local ToggleBtn = create("TextButton", {
        Name = "ToggleBtn",
        BackgroundColor3 = Theme.Background,
        Position = UDim2.new(0, 15, 0, 15),
        Size = UDim2.new(0, 180, 0, 45),
        Text = "",
        AutoButtonColor = false,
        ClipsDescendants = true,
        Parent = ScreenGui
    })
    corner(ToggleBtn, 12)
    stroke(ToggleBtn, Theme.Accent, 1.5).Transparency = 0.5

    create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0.5, 0),
        Position = UDim2.new(0, 10, 0, 5),
        Font = Enum.Font.GothamBold,
        Text = config.Name or "Sansik Hub",
        TextColor3 = Theme.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = ToggleBtn
    })
    create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0.5, 0),
        Position = UDim2.new(0, 10, 0, 20),
        Font = Enum.Font.Gotham,
        Text = "Tap to open",
        TextColor3 = Theme.Accent,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = ToggleBtn
    })

    -- Главное окно
    local MainFrame = create("Frame", {
        Name = "MainFrame",
        BackgroundColor3 = Theme.Background,
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 500, 0, 350),
        Visible = false,
        ClipsDescendants = true,
        Parent = ScreenGui
    })
    corner(MainFrame, 12)
    stroke(MainFrame, Theme.Accent, 1.5).Transparency = 0.3

    -- Топбар
    local TopBar = create("Frame", {
        BackgroundColor3 = Theme.Secondary,
        Size = UDim2.new(1, 0, 0, 40),
        BorderSizePixel = 0,
        Parent = MainFrame
    })
    corner(TopBar, 12)
    create("Frame", { -- Чтобы скругление было только сверху
        BackgroundColor3 = Theme.Secondary,
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.new(1, 0, 0.5, 0),
        BorderSizePixel = 0,
        Parent = TopBar
    })

    create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -80, 1, 0),
        Position = UDim2.new(0, 15, 0, 0),
        Font = Enum.Font.GothamBold,
        Text = config.Name or "Sansik Hub",
        TextColor3 = Theme.Text,
        TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = TopBar
    })

    local CloseBtn = create("TextButton", {
        BackgroundColor3 = Theme.Red,
        Position = UDim2.new(1, -30, 0, 10),
        Size = UDim2.new(0, 20, 0, 20),
        Text = "X",
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = Theme.Text,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Parent = TopBar
    })
    corner(CloseBtn, 6)

    -- Драг окна
    local dragging, dragInput, dragStart, startPos
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    TopBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- Анимации
    ToggleBtn.MouseButton1Click:Connect(function()
        ToggleBtn.Visible = false
        MainFrame.Visible = true
        MainFrame.Size = UDim2.new(0, 0, 0, 0)
        MainFrame.Position = UDim2.new(0.5, 0, 0.45, 0)
        TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.new(0, 500, 0, 350)
        }):Play()
        TweenService:Create(Blur, TweenInfo.new(0.3), {Size = 10}):Play()
    end)

    CloseBtn.MouseButton1Click:Connect(function()
        TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0.45, 0)
        }):Play()
        TweenService:Create(Blur, TweenInfo.new(0.3), {Size = 0}):Play()
        task.delay(0.3, function()
            MainFrame.Visible = false
            ToggleBtn.Visible = true
        end)
    end)

    -- Контейнер для вкладок (Сайдбар)
    local TabContainer = create("Frame", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 10, 0, 50),
        Size = UDim2.new(0, 120, 1, -60),
        Parent = MainFrame
    })

    -- Контейнер для контента
    local ContentContainer = create("Frame", {
        BackgroundColor3 = Theme.Secondary,
        Position = UDim2.new(0, 135, 0, 50),
        Size = UDim2.new(1, -145, 1, -60),
        Parent = MainFrame
    })
    corner(ContentContainer, 8)

    local Tabs = {}
    local ActiveTab = nil

    -- API: Создание вкладки
    function Window:CreateTab(tabConfig)
        local Tab = { Name = tabConfig.Name, Buttons = {} }

        local TabBtn = create("TextButton", {
            BackgroundColor3 = Theme.Background,
            Size = UDim2.new(1, 0, 0, 30),
            Position = UDim2.new(0, 0, 0, (#Tabs * 35)),
            Text = tabConfig.Name,
            Font = Enum.Font.GothamBold,
            TextColor3 = Theme.TextDark,
            TextSize = 12,
            AutoButtonColor = false,
            BorderSizePixel = 0,
            Parent = TabContainer
        })
        corner(TabBtn, 6)
        local TabStroke = stroke(TabBtn, Theme.Accent, 1)
        TabStroke.Transparency = 1

        -- Контейнер контента вкладки
        local TabContent = create("ScrollingFrame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -20, 1, -20),
            Position = UDim2.new(0, 10, 0, 10),
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.Accent,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            Visible = false,
            Parent = ContentContainer
        })

        table.insert(Tabs, Tab)
        Tab.TabBtn = TabBtn
        Tab.TabContent = TabContent

        TabBtn.MouseButton1Click:Connect(function()
            if ActiveTab then
                ActiveTab.TabContent.Visible = false
                TweenService:Create(ActiveTab.TabBtn, TweenInfo.new(0.2), {TextColor3 = Theme.TextDark}):Play()
                TweenService:Create(ActiveTab.TabBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Background}):Play()
                ActiveTab.TabStroke.Transparency = 1
            end
            ActiveTab = Tab
            Tab.TabContent.Visible = true
            TweenService:Create(TabBtn, TweenInfo.new(0.2), {TextColor3 = Theme.Accent}):Play()
            TweenService:Create(TabBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Secondary}):Play()
            TabStroke.Transparency = 0
        end)

        Tab.TabStroke = TabStroke

        -- Если это первая вкладка, открываем её (ИСПРАВЛЕНО)
        if #Tabs == 1 then
            task.spawn(function()
                task.wait(0.1)
                TabBtn:Click()
            end)
        end

        -- API вкладки: Создание секции
        function Tab:CreateSection(sectionName)
            local SectionFrame = create("Frame", {
                BackgroundColor3 = Theme.Background,
                Size = UDim2.new(1, -10, 0, 30),
                Position = UDim2.new(0, 0, 0, TabContent.CanvasSize.Y.Offset),
                Parent = TabContent
            })
            corner(SectionFrame, 6)
            create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -10, 1, 0),
                Position = UDim2.new(0, 10, 0, 0),
                Font = Enum.Font.GothamBold,
                Text = sectionName,
                TextColor3 = Theme.Accent,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = SectionFrame
            })
            TabContent.CanvasSize = UDim2.new(0, 0, 0, TabContent.CanvasSize.Y.Offset + 40)
        end

        -- API вкладки: Создание кнопки
        function Tab:CreateButton(btnConfig)
            local Btn = create("TextButton", {
                BackgroundColor3 = Theme.Secondary,
                Size = UDim2.new(1, -10, 0, 35),
                Position = UDim2.new(0, 0, 0, TabContent.CanvasSize.Y.Offset),
                Text = btnConfig.Name,
                Font = Enum.Font.GothamBold,
                TextColor3 = Theme.Text,
                TextSize = 13,
                AutoButtonColor = false,
                BorderSizePixel = 0,
                Parent = TabContent
            })
            corner(Btn, 6)
            local btnStroke = stroke(Btn, Theme.Accent, 1)
            btnStroke.Transparency = 1

            Btn.MouseEnter:Connect(function()
                TweenService:Create(btnStroke, TweenInfo.new(0.2), {Transparency = 0}):Play()
                TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Accent}):Play()
                TweenService:Create(Btn, TweenInfo.new(0.2), {TextColor3 = Theme.Background}):Play()
            end)
            Btn.MouseLeave:Connect(function()
                TweenService:Create(btnStroke, TweenInfo.new(0.2), {Transparency = 1}):Play()
                TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Secondary}):Play()
                TweenService:Create(Btn, TweenInfo.new(0.2), {TextColor3 = Theme.Text}):Play()
            end)
            Btn.MouseButton1Click:Connect(function()
                if btnConfig.Callback then btnConfig.Callback() end
            end)

            TabContent.CanvasSize = UDim2.new(0, 0, 0, TabContent.CanvasSize.Y.Offset + 45)
        end

        -- API вкладки: Создание переключателя (Toggle)
        function Tab:CreateToggle(toggleConfig)
            local ToggleFrame = create("Frame", {
                BackgroundColor3 = Theme.Secondary,
                Size = UDim2.new(1, -10, 0, 35),
                Position = UDim2.new(0, 0, 0, TabContent.CanvasSize.Y.Offset),
                Parent = TabContent
            })
            corner(ToggleFrame, 6)

            create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -60, 1, 0),
                Position = UDim2.new(0, 10, 0, 0),
                Font = Enum.Font.Gotham,
                Text = toggleConfig.Name,
                TextColor3 = Theme.Text,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = ToggleFrame
            })

            local ToggleBtnVisual = create("Frame", {
                BackgroundColor3 = Theme.Background,
                Position = UDim2.new(1, -50, 0.5, -10),
                Size = UDim2.new(0, 40, 0, 20),
                Parent = ToggleFrame
            })
            corner(ToggleBtnVisual, 10)

            local ToggleDot = create("Frame", {
                BackgroundColor3 = Theme.TextDark,
                Position = UDim2.new(0, 2, 0.5, -8),
                Size = UDim2.new(0, 16, 0, 16),
                Parent = ToggleBtnVisual
            })
            corner(ToggleDot, 8)

            local active = toggleConfig.CurrentValue or false
            local btnClick = create("TextButton", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 1, 0),
                Text = "",
                Parent = ToggleFrame
            })

            local function updateState(state)
                active = state
                if active then
                    TweenService:Create(ToggleDot, TweenInfo.new(0.2), {Position = UDim2.new(1, -18, 0.5, -8), BackgroundColor3 = Theme.Accent}):Play()
                    TweenService:Create(ToggleBtnVisual, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Accent}):Play()
                else
                    TweenService:Create(ToggleDot, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -8), BackgroundColor3 = Theme.TextDark}):Play()
                    TweenService:Create(ToggleBtnVisual, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Background}):Play()
                end
                if toggleConfig.Callback then toggleConfig.Callback(active) end
            end

            btnClick.MouseButton1Click:Connect(function()
                updateState(not active)
            end)

            if active then updateState(true) end

            TabContent.CanvasSize = UDim2.new(0, 0, 0, TabContent.CanvasSize.Y.Offset + 45)
        end

        -- API вкладки: Создание слайдера
        function Tab:CreateSlider(sliderConfig)
            local SliderFrame = create("Frame", {
                BackgroundColor3 = Theme.Secondary,
                Size = UDim2.new(1, -10, 0, 50),
                Position = UDim2.new(0, 0, 0, TabContent.CanvasSize.Y.Offset),
                Parent = TabContent
            })
            corner(SliderFrame, 6)

            local SliderText = create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -20, 0, 20),
                Position = UDim2.new(0, 10, 0, 5),
                Font = Enum.Font.Gotham,
                Text = sliderConfig.Name .. ": " .. tostring(sliderConfig.CurrentValue or sliderConfig.Range[1]),
                TextColor3 = Theme.Text,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = SliderFrame
            })

            local SliderBar = create("Frame", {
                BackgroundColor3 = Theme.Background,
                Position = UDim2.new(0, 10, 0, 30),
                Size = UDim2.new(1, -20, 0, 6),
                Parent = SliderFrame
            })
            corner(SliderBar, 3)

            local SliderFill = create("Frame", {
                BackgroundColor3 = Theme.Accent,
                Size = UDim2.new((sliderConfig.CurrentValue - sliderConfig.Range[1]) / (sliderConfig.Range[2] - sliderConfig.Range[1]), 0, 1, 0),
                Parent = SliderBar
            })
            corner(SliderFill, 3)

            local dragging = false
            local function updateSlider(input)
                local relativeX = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
                local value = sliderConfig.Range[1] + (relativeX * (sliderConfig.Range[2] - sliderConfig.Range[1]))
                value = math.floor(value / (sliderConfig.Increment or 1)) * (sliderConfig.Increment or 1)

                SliderFill.Size = UDim2.new(relativeX, 0, 1, 0)
                SliderText.Text = sliderConfig.Name .. ": " .. tostring(value) .. (sliderConfig.Suffix or "")

                if sliderConfig.Callback then sliderConfig.Callback(value) end
            end

            SliderBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    updateSlider(input)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateSlider(input)
                end
            end)

            TabContent.CanvasSize = UDim2.new(0, 0, 0, TabContent.CanvasSize.Y.Offset + 60)
        end

        return Tab
    end

    return Window
end

return SansikUI
